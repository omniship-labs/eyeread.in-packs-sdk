{
  "description": "Two settings share a key.",
  "pack": {
    "apiVersion": 1,
    "id": "com.example.foot-pedal",
    "name": "Foot Pedal",
    "version": "1.0.0",
    "author": {
      "name": "Jane Dev"
    },
    "license": "AGPL-3.0-or-later",
    "main": "main.js",
    "permissions": {
      "prompter:control": {}
    },
    "settings": [
      {
        "key": "k",
        "type": "toggle",
        "label": "A",
        "default": true
      },
      {
        "key": "k",
        "type": "toggle",
        "label": "B",
        "default": false
      }
    ]
  },
  "files": {
    "main.js": "// Foot Pedal: toggles the prompter from a pedal key.\neyeread.on('prompter:control', ({ prompter }) => {\n  window.addEventListener('keydown', (event) => {\n    if (event.key === 'F13') prompter.control({ action: 'toggle' });\n  });\n});\n"
  },
  "expect": {
    "valid": false,
    "code": "setting_key_duplicate",
    "stage": "package"
  }
}
