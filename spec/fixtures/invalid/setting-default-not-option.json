{
  "description": "A select default must be one of its options.",
  "pack": {
    "apiVersion": 1,
    "id": "com.example.foot-pedal",
    "name": "Foot Pedal",
    "version": "1.0.0",
    "author": {
      "name": "Jane Dev"
    },
    "license": "AGPL-3.0-or-later",
    "main": "main.js",
    "permissions": {
      "prompter:control": {}
    },
    "settings": [
      {
        "key": "k",
        "type": "select",
        "label": "K",
        "options": [
          {
            "value": "a",
            "label": "A"
          },
          {
            "value": "b",
            "label": "B"
          }
        ],
        "default": "c"
      }
    ]
  },
  "files": {
    "main.js": "// Foot Pedal: toggles the prompter from a pedal key.\neyeread.on('prompter:control', ({ prompter }) => {\n  window.addEventListener('keydown', (event) => {\n    if (event.key === 'F13') prompter.control({ action: 'toggle' });\n  });\n});\n"
  },
  "expect": {
    "valid": false,
    "code": "setting_default_invalid",
    "stage": "package"
  }
}
