{
  "description": "A bundle with no code of its own that includes one pack.",
  "pack": {
    "apiVersion": 1,
    "id": "com.example.streaming",
    "name": "Streaming setup",
    "version": "1.0.0",
    "author": {
      "name": "Jane Dev"
    },
    "license": "AGPL-3.0-or-later",
    "includes": [
      {
        "id": "com.example.foot-pedal",
        "version": "1.0.0"
      }
    ]
  },
  "files": {},
  "packs": [
    {
      "description": "Included pack",
      "pack": {
        "apiVersion": 1,
        "id": "com.example.foot-pedal",
        "name": "Foot Pedal",
        "version": "1.0.0",
        "author": {
          "name": "Jane Dev"
        },
        "license": "AGPL-3.0-or-later",
        "main": "main.js",
        "permissions": {
          "prompter:control": {}
        }
      },
      "files": {
        "main.js": "// Foot Pedal: toggles the prompter from a pedal key.\neyeread.on('prompter:control', ({ prompter }) => {\n  window.addEventListener('keydown', (event) => {\n    if (event.key === 'F13') prompter.control({ action: 'toggle' });\n  });\n});\n"
      }
    }
  ],
  "expect": {
    "valid": true
  }
}
